{
  "name": "marketing-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-pdf-worker": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync(require.resolve('pdfjs-dist/build/pdf.worker.min.mjs'),'public/pdf.worker.min.mjs')\"",
    "predev": "npm run copy-pdf-worker",
    "dev": "NODE_OPTIONS=--max-old-space-size=1536 next dev",
    "prebuild": "npm run copy-pdf-worker && vitest run tests/unit/sidebar-tabs.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.1.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/d3-geo": "^3.1.0",
    "@types/react-simple-maps": "^3.0.6",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.16",
    "html2canvas": "^1.4.1",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "marked": "^18.0.5",
    "next": "^14.2.35",
    "nodemailer": "^10.0.14",
    "openai": "^6.45.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.13.3",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
